<!--
    Light theme — same token keys as Dark.xaml. Contrast targets: body text >= 7:1 on surfaces,
    secondary text >= 4.5:1, metric colours >= 3:1 against the surface (WCAG AA / 1.4.11).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <Color x:Key="BgColor">#FFF2F4F7</Color>
    <Color x:Key="PanelColor">#FFFFFFFF</Color>
    <Color x:Key="PanelAltColor">#FFEDF0F4</Color>
    <Color x:Key="BorderColor">#FFD0D7DE</Color>

    <!-- Text -->
    <Color x:Key="TextColor">#FF1F2328</Color>
    <Color x:Key="SubtleColor">#FF57606A</Color>

    <!-- Interaction -->
    <Color x:Key="HoverColor">#FFE3E8EE</Color>
    <Color x:Key="SelectionColor">#FFD8E7F5</Color>
    <Color x:Key="TrackColor">#FFE1E6EC</Color>

    <!-- Status -->
    <Color x:Key="DangerColor">#FFCF222E</Color>
    <Color x:Key="SuccessColor">#FF1A7F37</Color>
    <Color x:Key="WarningColor">#FF9A6700</Color>

    <!-- Metric colours -->
    <Color x:Key="MetricRamColor">#FF2563EB</Color>
    <Color x:Key="MetricDiskColor">#FFB45309</Color>
    <Color x:Key="MetricGpuColor">#FF7C3AED</Color>
    <Color x:Key="MetricNetDownColor">#FF1A7F37</Color>
    <Color x:Key="MetricNetUpColor">#FF2563EB</Color>
    <Color x:Key="MetricTempColor">#FFB42318</Color>

    <SolidColorBrush x:Key="BgBrush"           Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="PanelBrush"        Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="CardBrush"         Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="PanelAltBrush"     Color="{StaticResource PanelAltColor}"/>
    <SolidColorBrush x:Key="BorderBrush"       Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush"         Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="SubtleBrush"       Color="{StaticResource SubtleColor}"/>
    <SolidColorBrush x:Key="HoverBrush"        Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="SelectionBrush"    Color="{StaticResource SelectionColor}"/>
    <SolidColorBrush x:Key="TrackBrush"        Color="{StaticResource TrackColor}"/>
    <SolidColorBrush x:Key="DangerBrush"       Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"      Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush"      Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="MetricRamBrush"    Color="{StaticResource MetricRamColor}"/>
    <SolidColorBrush x:Key="MetricDiskBrush"   Color="{StaticResource MetricDiskColor}"/>
    <SolidColorBrush x:Key="MetricGpuBrush"    Color="{StaticResource MetricGpuColor}"/>
    <SolidColorBrush x:Key="MetricNetDownBrush" Color="{StaticResource MetricNetDownColor}"/>
    <SolidColorBrush x:Key="MetricNetUpBrush"  Color="{StaticResource MetricNetUpColor}"/>
    <SolidColorBrush x:Key="MetricTempBrush"   Color="{StaticResource MetricTempColor}"/>

    <!-- Translucent status fills -->
    <SolidColorBrush x:Key="DangerFillBrush"   Color="#22CF222E"/>
    <SolidColorBrush x:Key="SuccessFillBrush"  Color="#1A1A7F37"/>
    <SolidColorBrush x:Key="WarningFillBrush"  Color="#269A6700"/>
    <SolidColorBrush x:Key="NeutralFillBrush"  Color="#1457606A"/>

    <!-- Window chrome -->
    <Color x:Key="ChromeColor">#FFE8ECF1</Color>
    <SolidColorBrush x:Key="ChromeBrush" Color="{StaticResource ChromeColor}"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="{StaticResource BorderColor}"/>

</ResourceDictionary>
