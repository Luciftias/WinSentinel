<!--
    Dark theme — colour tokens only. Every brush the UI needs is defined here; styles live in
    Shared.xaml and reference these keys with DynamicResource so ThemeManager can hot-swap the
    whole dictionary at runtime. Keep this file free of styles/templates.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <Color x:Key="BgColor">#FF0E1116</Color>
    <Color x:Key="PanelColor">#FF161B22</Color>
    <Color x:Key="PanelAltColor">#FF1C232D</Color>
    <Color x:Key="BorderColor">#FF2A323D</Color>

    <!-- Text -->
    <Color x:Key="TextColor">#FFE6EDF3</Color>
    <Color x:Key="SubtleColor">#FF9AA4B2</Color>

    <!-- Interaction -->
    <Color x:Key="HoverColor">#FF212A36</Color>
    <Color x:Key="SelectionColor">#FF1F3746</Color>
    <Color x:Key="TrackColor">#FF212835</Color>

    <!-- Status -->
    <Color x:Key="DangerColor">#FFF85149</Color>
    <Color x:Key="SuccessColor">#FF3FB950</Color>
    <Color x:Key="WarningColor">#FFD29922</Color>

    <!-- Metric colours (CPU uses the live accent) -->
    <Color x:Key="MetricRamColor">#FF3B82F6</Color>
    <Color x:Key="MetricDiskColor">#FFD97706</Color>
    <Color x:Key="MetricGpuColor">#FF8B5CF6</Color>
    <Color x:Key="MetricNetDownColor">#FF2EA043</Color>
    <Color x:Key="MetricNetUpColor">#FF3B82F6</Color>

    <SolidColorBrush x:Key="BgBrush"           Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="PanelBrush"        Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="CardBrush"         Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="PanelAltBrush"     Color="{StaticResource PanelAltColor}"/>
    <SolidColorBrush x:Key="BorderBrush"       Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush"         Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="SubtleBrush"       Color="{StaticResource SubtleColor}"/>
    <SolidColorBrush x:Key="HoverBrush"        Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="SelectionBrush"    Color="{StaticResource SelectionColor}"/>
    <SolidColorBrush x:Key="TrackBrush"        Color="{StaticResource TrackColor}"/>
    <SolidColorBrush x:Key="DangerBrush"       Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"      Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush"      Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="MetricRamBrush"    Color="{StaticResource MetricRamColor}"/>
    <SolidColorBrush x:Key="MetricDiskBrush"   Color="{StaticResource MetricDiskColor}"/>
    <SolidColorBrush x:Key="MetricGpuBrush"    Color="{StaticResource MetricGpuColor}"/>
    <SolidColorBrush x:Key="MetricNetDownBrush" Color="{StaticResource MetricNetDownColor}"/>
    <SolidColorBrush x:Key="MetricNetUpBrush"  Color="{StaticResource MetricNetUpColor}"/>

    <!-- Translucent status fills -->
    <SolidColorBrush x:Key="DangerFillBrush"   Color="#33F85149"/>
    <SolidColorBrush x:Key="SuccessFillBrush"  Color="#223FB950"/>
    <SolidColorBrush x:Key="WarningFillBrush"  Color="#22D29922"/>
    <SolidColorBrush x:Key="NeutralFillBrush"  Color="#1F8B949E"/>

    <!-- Window chrome -->
    <Color x:Key="ChromeColor">#FF10151C</Color>
    <SolidColorBrush x:Key="ChromeBrush" Color="{StaticResource ChromeColor}"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="{StaticResource BorderColor}"/>

</ResourceDictionary>
