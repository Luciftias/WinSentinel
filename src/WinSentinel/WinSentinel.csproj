<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>WinSentinel</AssemblyName>
    <RootNamespace>WinSentinel</RootNamespace>
    <Version>2.3.0</Version>
    <Authors>WinSentinel</Authors>
    <Product>WinSentinel</Product>
    <Description>Floating Windows 10/11 system monitor &amp; optimizer — CPU/RAM/GPU/disk/network gauges, process control (Efficiency Mode, suspend, priorities), startup manager, themes. No third-party runtime dependencies.</Description>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFAC010/WFO0003: the WinForms NotifyIcon brings the WinForms analyzer along; the
         manifest's PerMonitorV2 DPI declaration is correct for WPF and intentionally kept. -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
  </PropertyGroup>

  <!--
    Both WPF and WinForms are enabled (WinForms only for the NotifyIcon tray support).
    The WinForms implicit usings are removed globally so that System.Windows types
    (MessageBox, Application, Point, CheckBox, ...) are never ambiguous with their
    System.Windows.Forms / System.Drawing counterparts. The single file that needs
    WinForms (Helpers/TrayIconManager.cs) imports those namespaces explicitly.
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The .ico files are already picked up by the SDK's default None glob, so we use
      Update (not Include) to add CopyToOutputDirectory metadata without creating a
      duplicate item (avoids NETSDK1022). tray.ico is loaded at runtime by the tray
      manager; app.ico is also embedded as the exe icon via <ApplicationIcon>.
    -->
    <None Update="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\tray.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!-- Promote logo.png from the default None glob to a WPF Resource so it can be
         shown inside the app via the pack URI /WinSentinel;component/Assets/logo.png. -->
    <None Remove="Assets\logo.png" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinSentinel.Abstractions\WinSentinel.Abstractions.csproj" />
  </ItemGroup>

</Project>
