<Application x:Class="WinSentinel.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!--
        Resource dictionary layout (order matters — ThemeManager relies on it):
          [0] Themes/Shared.xaml   fonts + control styles (theme-agnostic, DynamicResource)
          [1] Themes/Dark.xaml     colour tokens; replaced at runtime with Light.xaml as needed
          [2] (runtime)            accent dictionary injected by Helpers/ThemeManager
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Shared.xaml"/>
                <ResourceDictionary Source="Themes/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
