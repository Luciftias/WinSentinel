<Window x:Class="WinSentinel.Views.PluginParameterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinSentinel — Plugin command"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" UseLayoutRounding="True"
        ShowInTaskbar="False">

    <StackPanel Margin="20">
        <TextBlock x:Name="HeaderText" Style="{StaticResource H1}" FontSize="15" Text="Plugin command"/>
        <TextBlock x:Name="LabelText" Style="{StaticResource Label}" Margin="0,10,0,6" Text="Value"/>
        <TextBox x:Name="ValueBox" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="Note: network analysis tools should only be pointed at systems you own or have explicit permission to test."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" Click="OnCancel"/>
            <Button Content="Run" Style="{StaticResource AccentButton}" Margin="0" Click="OnRun" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
