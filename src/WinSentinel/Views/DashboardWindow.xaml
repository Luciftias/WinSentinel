<Window x:Class="WinSentinel.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:WinSentinel.Controls"
        xmlns:conv="clr-namespace:WinSentinel.Converters"
        Title="WinSentinel — System Monitor &amp; Optimizer"
        Width="1060" Height="720" MinWidth="880" MinHeight="580"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <conv:ProtectedToBrushConverter x:Key="ProtectedToBrush"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:StartupStateConverter x:Key="StartupState"/>

        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="BigMetric" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SmallAction" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════ Header ═══════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Style="{StaticResource Card}" VerticalAlignment="Center">
                <Image Source="/WinSentinel;component/Assets/logo.png" Width="34" Height="34"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="WinSentinel" Style="{StaticResource H1}" FontSize="20"/>
                <TextBlock Style="{StaticResource Label}">
                    <Run Text="{Binding MachineName, Mode=OneWay}"/><Run Text="  •  up "/><Run Text="{Binding Uptime, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="6" Background="{DynamicResource NeutralFillBrush}" Padding="10,5" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource Label}">
                        <Run Text="{Binding ProcessCount, Mode=OneWay}"/><Run Text=" processes  •  "/><Run Text="{Binding ThreadCount, Mode=OneWay}"/><Run Text=" threads"/>
                    </TextBlock>
                </Border>
                <Border CornerRadius="6" Background="{DynamicResource SuccessFillBrush}" Padding="10,5">
                    <TextBlock Text="Running elevated" Foreground="{DynamicResource SuccessBrush}"
                               FontFamily="{DynamicResource UiFont}" FontSize="12" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════ Navigation + pages ═══════════════════════════ -->
        <TabControl Grid.Row="1" Style="{StaticResource NavTabControl}"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

            <!-- ───────────────────────── Overview ───────────────────────── -->
            <TabItem Header="Overview" Style="{StaticResource NavTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>

                        <!-- Metric cards -->
                        <UniformGrid Columns="4" Margin="0,0,0,0">
                            <!-- CPU -->
                            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="150"/>
                                        <RowDefinition Height="36"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="CPU" Style="{StaticResource CardTitle}"/>
                                    <ctrl:CircularGauge Grid.Row="1" Margin="0,6" Value="{Binding Cpu}" Maximum="100"
                                                        Caption="utilisation" RingBrush="{DynamicResource AccentBrush}"/>
                                    <ctrl:Sparkline Grid.Row="2" Values="{Binding CpuHistory}" Maximum="100"
                                                    LineBrush="{DynamicResource AccentBrush}" FillBrush="{DynamicResource AccentFillSoftBrush}"/>
                                    <TextBlock Grid.Row="3" Text="{Binding CpuDetail}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </Grid>
                            </Border>

                            <!-- RAM -->
                            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="150"/>
                                        <RowDefinition Height="36"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="MEMORY" Style="{StaticResource CardTitle}"/>
                                    <ctrl:CircularGauge Grid.Row="1" Margin="0,6" Value="{Binding Ram}" Maximum="100"
                                                        Caption="in use" RingBrush="{DynamicResource MetricRamBrush}"/>
                                    <ctrl:Sparkline Grid.Row="2" Values="{Binding RamHistory}" Maximum="100"
                                                    LineBrush="{DynamicResource MetricRamBrush}" FillBrush="{DynamicResource AccentFillSoftBrush}"/>
                                    <TextBlock Grid.Row="3" Text="{Binding RamDetail}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </Grid>
                            </Border>

                            <!-- GPU -->
                            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="150"/>
                                        <RowDefinition Height="36"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="GPU" Style="{StaticResource CardTitle}"/>
                                    <ctrl:CircularGauge Grid.Row="1" Margin="0,6" Value="{Binding Gpu}" Maximum="100"
                                                        Caption="busiest engine" RingBrush="{DynamicResource MetricGpuBrush}"/>
                                    <ctrl:Sparkline Grid.Row="2" Values="{Binding GpuHistory}" Maximum="100"
                                                    LineBrush="{DynamicResource MetricGpuBrush}" FillBrush="{DynamicResource AccentFillSoftBrush}"/>
                                    <TextBlock Grid.Row="3" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                               Text="Live GPU engine counters (WDDM). Hidden on systems without them."/>
                                </Grid>
                            </Border>

                            <!-- Disk -->
                            <Border Style="{StaticResource Card}" Padding="16,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="150"/>
                                        <RowDefinition Height="36"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="DISK ACTIVITY" Style="{StaticResource CardTitle}"/>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DiskDetail}" Style="{StaticResource BigMetric}"
                                                   TextWrapping="Wrap" FontSize="16" Foreground="{DynamicResource MetricDiskBrush}"/>
                                    </StackPanel>
                                    <ctrl:Sparkline Grid.Row="2" Values="{Binding DiskHistory}" Maximum="{Binding DiskMax}"
                                                    LineBrush="{DynamicResource MetricDiskBrush}" FillBrush="{DynamicResource AccentFillSoftBrush}"/>
                                    <TextBlock Grid.Row="3" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                               Text="Physical disk (_Total) throughput."/>
                                </Grid>
                            </Border>
                        </UniformGrid>

                        <!-- Network + system -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="56"/>
                                        <RowDefinition Height="56"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="NETWORK" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Grid.Row="1" Text="{Binding NetDetail}" Style="{StaticResource BigMetric}"
                                               FontSize="16" Margin="0,6,0,4"/>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="DOWN" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        <ctrl:Sparkline Grid.Column="1" Values="{Binding NetDownHistory}" Maximum="{Binding NetMax}"
                                                        LineBrush="{DynamicResource MetricNetDownBrush}"/>
                                    </Grid>
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="UP" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        <ctrl:Sparkline Grid.Column="1" Values="{Binding NetUpHistory}" Maximum="{Binding NetMax}"
                                                        LineBrush="{DynamicResource MetricNetUpBrush}"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="SYSTEM" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Label}">
                                        <Run Text="Uptime  "/><Run Text="{Binding Uptime, Mode=OneWay}" Foreground="{DynamicResource TextBrush}"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Label}">
                                        <Run Text="Processes  "/><Run Text="{Binding ProcessCount, Mode=OneWay}" Foreground="{DynamicResource TextBrush}"/>
                                        <Run Text="   Threads  "/><Run Text="{Binding ThreadCount, Mode=OneWay}" Foreground="{DynamicResource TextBrush}"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Label}" TextWrapping="Wrap"
                                               Text="{Binding CpuDetail}"/>
                                    <StackPanel Visibility="{Binding BatteryPresent, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                        <TextBlock Text="BATTERY" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="{Binding BatteryDetail}" Style="{StaticResource BigMetric}" FontSize="15"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Memory tuning -->
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Memory tuning" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,16,0"
                                               Text="Trim asks Windows to page out resident memory for non-protected processes — useful after heavy workloads, but the OS pages it back in on demand. Purge Standby is an advanced system-wide cache flush: honest, short-lived, and only worth it in specific cases."/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Trim Memory Now" Style="{StaticResource AccentButton}"
                                            Command="{Binding TrimAllCommand}"/>
                                    <Button Content="Purge Standby…" Style="{StaticResource GhostButton}" Margin="0"
                                            Command="{Binding PurgeStandbyCommand}"
                                            ToolTip="Advanced: clears the standby (cached) memory list. Administrator only."/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ───────────────────────── Processes ───────────────────────── -->
            <TabItem Header="Processes" Style="{StaticResource NavTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Row 1: search + refresh controls -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="260" Margin="0,0,14,0">
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Filter by process name, PID or publisher (Ctrl+F)"/>
                            <TextBlock Text="Search name, PID or publisher…" IsHitTestVisible="False"
                                       Foreground="{DynamicResource SubtleBrush}" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="{Binding AutoRefresh}"
                                          ToolTip="Auto-refresh the process list" Margin="0,0,10,0"/>
                            <ToggleButton Content="Pause" IsChecked="{Binding Paused}" Margin="0,0,14,0"
                                          FontSize="12" Padding="10,5" Cursor="Hand"
                                          ToolTip="Pause automatic refresh (manual refresh still works)">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource GhostToggleButton}">
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource WarningFillBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <TextBlock Text="Every" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Width="76" ItemsSource="{Binding RefreshSecondsOptions}"
                                      SelectedItem="{Binding SelectedRefreshSeconds}"
                                      ItemStringFormat="{}{0} s" Margin="0,0,14,0"/>
                            <Button Content="Refresh now" Style="{StaticResource SmallAction}"
                                    Command="{Binding RefreshProcessesCommand}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="3" Style="{StaticResource Label}" VerticalAlignment="Center">
                            <Run Text="{Binding ProcessCount, Mode=OneWay}"/><Run Text=" processes  •  Ctrl+F search  •  Del ends task  •  Alt+E efficiency mode"/>
                        </TextBlock>
                    </Grid>

                    <!-- Row 2: actions -->
                    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                        <Button Content="End Task" Style="{StaticResource DangerButton}" Command="{Binding KillSelectedCommand}"/>
                        <Button Content="End Tree" Style="{StaticResource GhostButton}" Command="{Binding KillTreeSelectedCommand}"
                                ToolTip="Terminate the process and all of its children"/>
                        <Button Content="Suspend / Resume" Style="{StaticResource GhostButton}" Command="{Binding SuspendResumeSelectedCommand}"/>
                        <Button Content="Efficiency Mode" Style="{StaticResource GhostButton}" Command="{Binding ToggleEcoSelectedCommand}"
                                ToolTip="Toggle Windows EcoQoS: run on efficient cores / clock speeds"/>
                        <Button Content="Trim Working Set" Style="{StaticResource GhostButton}" Command="{Binding TrimSelectedCommand}"/>
                        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,3,12,3"/>
                        <TextBlock Text="Priority" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="126" ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding SelectedPriority}" Margin="0,0,8,0"/>
                        <Button Content="Apply" Style="{StaticResource SmallAction}" Command="{Binding ApplyPriorityCommand}"/>
                        <Button Content="CPU Affinity…" Style="{StaticResource SmallAction}" Click="OnAffinityClick"/>
                        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,3,12,3"/>
                        <TextBlock Text="I/O" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="104" ItemsSource="{Binding IoPriorityOptions}" SelectedItem="{Binding SelectedIoPriority}" Margin="0,0,8,0"
                                  ToolTip="Disk I/O priority (NtSetInformationProcess). Very low = background I/O."/>
                        <Button Content="Apply" Style="{StaticResource SmallAction}" Command="{Binding ApplyIoPriorityCommand}"/>
                        <TextBlock Text="Memory" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="10,0,8,0"/>
                        <ComboBox Width="112" ItemsSource="{Binding MemoryPriorityOptions}" SelectedItem="{Binding SelectedMemoryPriority}" Margin="0,0,8,0"
                                  ToolTip="Memory priority: lower priority pages are trimmed first by Windows"/>
                        <Button Content="Apply" Style="{StaticResource SmallAction}" Command="{Binding ApplyMemoryPriorityCommand}"/>
                    </WrapPanel>

                    <!-- Table -->
                    <DataGrid Grid.Row="2" Style="{StaticResource AppDataGrid}"
                              ItemsSource="{Binding ProcessesView}"
                              SelectedItem="{Binding SelectedProcess, Mode=TwoWay}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="{Binding IsProtected, Converter={StaticResource ProtectedToBrush}}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="End task" Command="{Binding KillSelectedCommand}"/>
                                <MenuItem Header="End process tree" Command="{Binding KillTreeSelectedCommand}"/>
                                <MenuItem Header="Suspend / Resume" Command="{Binding SuspendResumeSelectedCommand}"/>
                                <MenuItem Header="Toggle efficiency mode" Command="{Binding ToggleEcoSelectedCommand}"/>
                                <MenuItem Header="Trim working set" Command="{Binding TrimSelectedCommand}"/>
                                <Separator/>
                                <MenuItem Header="Open file location" Command="{Binding OpenFileLocationCommand}"/>
                                <MenuItem Header="Copy details" Command="{Binding CopyDetailsCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="*" SortMemberPath="Name"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" SortMemberPath="Pid"/>
                            <DataGridTextColumn Header="CPU" Binding="{Binding CpuDisplay}" Width="76" SortMemberPath="CpuPercent"/>
                            <DataGridTextColumn Header="Memory" Binding="{Binding MemoryDisplay}" Width="100" SortMemberPath="MemoryMB"/>
                            <DataGridTextColumn Header="Disk" Binding="{Binding DiskDisplay}" Width="96" SortMemberPath="DiskBps"/>
                            <DataGridTextColumn Header="GPU" Binding="{Binding GpuDisplay}" Width="72" SortMemberPath="GpuPercent"/>
                            <DataGridTextColumn Header="Threads" Binding="{Binding Threads}" Width="76" SortMemberPath="Threads"/>
                            <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="104" SortMemberPath="Priority"/>
                            <DataGridTemplateColumn Header="ECO" Width="58" SortMemberPath="IsEco">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="chip" CornerRadius="4" Background="{DynamicResource SuccessFillBrush}"
                                                Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="ECO" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsEco}" Value="False">
                                                <Setter TargetName="chip" Property="Visibility" Value="Hidden"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="STATE" Width="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StateDisplay}" FontSize="11"
                                                   Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ───────────────────────── Startup ───────────────────────── -->
            <TabItem Header="Startup" Style="{StaticResource NavTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button Content="Refresh" Style="{StaticResource SmallAction}" Command="{Binding RefreshStartupCommand}"/>
                        <Button Content="Enable / Disable" Style="{StaticResource GhostButton}" Command="{Binding ToggleStartupCommand}"
                                ToolTip="Toggles the entry via Explorer's StartupApproved key (per-user entries only)"/>
                        <Button Content="Remove (HKCU)" Style="{StaticResource DangerButton}" Command="{Binding RemoveStartupCommand}"/>
                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Text="Run/RunOnce + Startup folders, per-user and machine-wide. HKLM entries are read-only here."/>
                    </WrapPanel>

                    <DataGrid Grid.Row="1" Style="{StaticResource AppDataGrid}"
                              ItemsSource="{Binding StartupItems}"
                              SelectedItem="{Binding SelectedStartup, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="240"/>
                            <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="*"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding LocationDisplay}" Width="160"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Enabled, Converter={StaticResource StartupState}}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Add (HKCU):" Style="{StaticResource Label}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" x:Name="StartupNameBox" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="2" Text="→" Foreground="{DynamicResource SubtleBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="3" x:Name="StartupCommandBox" Margin="0,0,10,0" x:FieldModifier="private"/>
                            <Button Grid.Column="4" Content="Add" Style="{StaticResource AccentButton}" Click="OnAddStartupClick"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ───────────────────────── Settings ───────────────────────── -->
            <TabItem Header="Settings" Style="{StaticResource NavTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>

                        <!-- Appearance -->
                        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Appearance" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,12"
                                           Text="Theme and accent apply instantly to every window and are remembered across launches. System follows the Windows app theme and accent colour."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Theme" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding ThemeChoice}" Margin="0,0,24,0"/>
                                    <TextBlock Grid.Column="2" Text="Accent" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding AccentOptions}" SelectedItem="{Binding AccentChoice}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Monitoring -->
                        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Monitoring" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,12"
                                           Text="System sampling drives the gauges, tray tooltip and alerts. The process table refreshes on its own cadence and can be paused any time."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Sample every" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding SampleIntervalOptions}"
                                              SelectedItem="{Binding SelectedSampleIntervalMs}" ItemStringFormat="{}{0} ms" Margin="0,0,24,0"/>
                                    <TextBlock Grid.Column="2" Text="Process refresh" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding RefreshSecondsOptions}"
                                              SelectedItem="{Binding SelectedRefreshSeconds}" ItemStringFormat="{}{0} s" Margin="0,0,24,0"/>
                                    <CheckBox Grid.Column="4" Content="Auto-refresh processes" IsChecked="{Binding AutoRefresh}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Balloon -->
                        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Floating balloon" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,12"
                                           Text="The always-on-top widget. Drag it anywhere — the position is remembered. Right-click it for quick actions."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" Content="Show balloon" IsChecked="{Binding BalloonVisible}"
                                              VerticalAlignment="Center" Margin="0,0,24,0"/>
                                    <CheckBox Grid.Column="1" Content="GPU row" IsChecked="{Binding BalloonShowGpu}"
                                              VerticalAlignment="Center" Margin="0,0,20,0"/>
                                    <CheckBox Grid.Column="2" Content="Network row" IsChecked="{Binding BalloonShowNet}"
                                              VerticalAlignment="Center" Margin="0,0,20,0"/>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <TextBlock Text="Opacity" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Slider Width="140" Minimum="0.3" Maximum="1.0" Value="{Binding BalloonOpacity}"
                                                VerticalAlignment="Center" TickFrequency="0.1" IsSnapToTickEnabled="False"/>
                                    </StackPanel>
                                    <Button Grid.Column="4" Content="Reset position" Style="{StaticResource SmallAction}"
                                            HorizontalAlignment="Left" Margin="24,0,0,0"
                                            Command="{Binding ResetBalloonPositionCommand}"/>
                                </Grid>
                                <CheckBox Content="Disk row" IsChecked="{Binding BalloonShowDisk}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Alerts -->
                        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Resource alerts" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,12"
                                           Text="A tray alert fires when CPU or memory stays above your threshold for the chosen duration. Alerts only inform — they never change system state. Repeated alerts of the same kind are rate-limited."/>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Content="Enable alerts" IsChecked="{Binding AlertsEnabled}" VerticalAlignment="Center" Margin="0,0,24,0"/>
                                    <TextBlock Text="CPU ≥" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider Width="150" Minimum="50" Maximum="100" Value="{Binding AlertCpuPercent}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AlertCpuPercent, StringFormat={}{0:0}%}" Style="{StaticResource Label}"
                                               VerticalAlignment="Center" Margin="8,0,24,0" MinWidth="36"/>
                                    <TextBlock Text="RAM ≥" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider Width="150" Minimum="50" Maximum="100" Value="{Binding AlertRamPercent}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AlertRamPercent, StringFormat={}{0:0}%}" Style="{StaticResource Label}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="36"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Sustained for" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider Width="150" Minimum="3" Maximum="60" Value="{Binding AlertSustainSeconds}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AlertSustainSeconds, StringFormat={}{0:0} s}" Style="{StaticResource Label}"
                                               VerticalAlignment="Center" Margin="8,0,24,0" MinWidth="36"/>
                                    <TextBlock Text="Cooldown" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider Width="150" Minimum="1" Maximum="30" Value="{Binding AlertCooldownMinutes}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AlertCooldownMinutes, StringFormat={}{0:0} min}" Style="{StaticResource Label}"
                                               VerticalAlignment="Center" Margin="8,0,24,0" MinWidth="44"/>
                                    <Button Content="Test alert" Style="{StaticResource SmallAction}" Command="{Binding TestAlertCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Safety -->
                        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Safety" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,12"
                                           Text="OS-critical processes are always protected, regardless of these options. Extra confirmations are yours to tune."/>
                                <CheckBox Content="Confirm before ending a task" IsChecked="{Binding ConfirmKill}" Margin="0,0,0,8"/>
                                <CheckBox Content="Confirm before removing a startup entry" IsChecked="{Binding ConfirmStartup}"/>
                            </StackPanel>
                        </Border>

                        <!-- About -->
                        <Border Style="{StaticResource Card}" Padding="18,14">
                            <StackPanel>
                                <TextBlock Text="About" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Label}" Margin="0,6,0,0" Text="{Binding VersionText}"/>
                                <TextBlock Style="{StaticResource Label}" Margin="0,4,0,0"
                                           Text="Floating system monitor &amp; optimizer — C# / .NET / WPF, MVVM, zero third-party dependencies."/>
                                <TextBlock Style="{StaticResource Label}" Margin="0,4,0,0" TextWrapping="Wrap">
                                    <Run Text="Settings file: "/><Run Text="{Binding SettingsPath, Mode=OneWay}" Foreground="{DynamicResource TextBrush}"/>
                                </TextBlock>
                                <Button Content="Reset all settings" Style="{StaticResource DangerButton}" Margin="0,12,0,0"
                                        HorizontalAlignment="Left" Command="{Binding ResetSettingsCommand}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Caption}" Margin="2,12,0,4" TextWrapping="Wrap"
                                   Text="Honest engineering note: working-set trims and standby purges are tuning aids, not magic. Windows pages memory back in on demand — no tool can make RAM permanently disappear while programs keep running."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ═══════════════════════════ Status bar ═══════════════════════════ -->
        <Border Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource Card}" Padding="14,9">
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SubtleBrush}"
                       FontFamily="{DynamicResource UiFont}" FontSize="12" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
